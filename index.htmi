<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shivani's Birthday 💖</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  min-height:100vh;
  overflow:hidden;
  color:white;
  background:linear-gradient(135deg,#ff4e8a,#7b2ff7,#00c6ff);
}

.screen{
  display:none;
  min-height:100vh;
  width:100%;
  padding:25px;
  text-align:center;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  animation:fade .7s ease;
}

.screen.active{
  display:flex;
}

@keyframes fade{
  from{opacity:0;transform:scale(.95)}
  to{opacity:1;transform:scale(1)}
}

.card{
  width:min(92%,500px);
  padding:30px 22px;
  border-radius:30px;
  background:rgba(255,255,255,.16);
  backdrop-filter:blur(12px);
  box-shadow:0 15px 50px rgba(0,0,0,.25);
  border:1px solid rgba(255,255,255,.3);
}

h1{
  font-size:clamp(34px,9vw,60px);
  margin-bottom:15px;
}

h2{
  font-size:clamp(27px,7vw,45px);
  margin-bottom:18px;
}

p{
  font-size:18px;
  line-height:1.7;
  margin:12px 0;
}

.name{
  color:#fff;
  text-shadow:0 0 15px #ffb6d5;
}

button{
  margin-top:20px;
  padding:15px 28px;
  border:none;
  border-radius:50px;
  background:white;
  color:#e52e78;
  font-size:17px;
  font-weight:bold;
  cursor:pointer;
  box-shadow:0 8px 25px rgba(0,0,0,.25);
  transition:.2s;
}

button:active{
  transform:scale(.94);
}

.emoji{
  font-size:65px;
  margin-bottom:15px;
  animation:bounce 1.5s infinite;
}

@keyframes bounce{
  50%{transform:translateY(-12px)}
}

.memory{
  margin:15px 0;
  padding:15px;
  border-radius:20px;
  background:rgba(255,255,255,.14);
  font-size:20px;
}

input{
  width:85%;
  padding:15px;
  border:none;
  border-radius:30px;
  text-align:center;
  font-size:18px;
  outline:none;
  margin-top:12px;
}

.result{
  margin-top:15px;
  min-height:28px;
  font-weight:bold;
}

.heart{
  position:fixed;
  bottom:-30px;
  font-size:25px;
  animation:float 6s linear infinite;
  pointer-events:none;
}

@keyframes float{
  0%{transform:translateY(0) rotate(0);opacity:0}
  15%{opacity:1}
  100%{transform:translateY(-110vh) rotate(360deg);opacity:0}
}

.confetti{
  position:fixed;
  width:10px;
  height:18px;
  top:-20px;
  animation:fall 4s linear forwards;
  pointer-events:none;
}

@keyframes fall{
  to{
    transform:translateY(110vh) rotate(720deg);
  }
}

.small{
  font-size:15px;
  opacity:.9;
}
</style>
</head>

<body>

<!-- PAGE 1 -->
<section class="screen active" id="page1">
  <div class="card">
    <div class="emoji">💖</div>
    <h1>Hey <span class="name">Shivani!</span></h1>
    <p>I have a little surprise waiting for you... 👀✨</p>
    <p>But you have to unlock it step by step. 😌</p>
    <button onclick="nextPage()">Open Your Surprise 💌</button>
  </div>
</section>

<!-- PAGE 2 -->
<section class="screen" id="page2">
  <div class="card">
    <div class="emoji">🌸</div>
    <h2>For You, Shivani 💕</h2>
    <p>
      Some people come into our life and slowly become
      a beautiful part of our memories.
    </p>
    <p>
      You are one of those special people. 🫂💖
    </p>
    <button onclick="nextPage()">Continue ✨</button>
  </div>
</section>

<!-- PAGE 3 -->
<section class="screen" id="page3">
  <div class="card">
    <div class="emoji">📸</div>
    <h2>Our Little Memories 🫂</h2>

    <div class="memory">😂 Endless laughter</div>
    <div class="memory">🤝 Crazy conversations</div>
    <div class="memory">💖 Beautiful memories</div>
    <div class="memory">✨ Moments worth remembering</div>

    <button onclick="nextPage()">One More Surprise 🎁</button>
  </div>
</section>

<!-- PAGE 4 -->
<section class="screen" id="page4">
  <div class="card">
    <div class="emoji">🎂</div>
    <h1>Happy Birthday!</h1>
    <h2 class="name">Shivani Lokhande 💖</h2>

    <p>
      May your smile always stay this beautiful,
      your heart stay happy,
      and your life be filled with countless
      beautiful moments. ✨
    </p>

    <button onclick="nextPage()">Wait... There's More 👀</button>
  </div>
</section>

<!-- PAGE 5 -->
<section class="screen" id="page5">
  <div class="card">
    <div class="emoji">🧩</div>
    <h2>Birthday Puzzle 🔐</h2>

    <p>
      Okay Shivani... let's see how well you know
      your own birthday! 😜
    </p>

    <p><b>Your birthday month is...?</b></p>

    <input id="answer" type="text" placeholder="Type the month...">

    <button onclick="checkAnswer()">Unlock 🔓</button>

    <div class="result" id="result"></div>
  </div>
</section>

<!-- PAGE 6 -->
<section class="screen" id="page6">
  <div class="card">
    <div class="emoji">👑</div>
    <h2>Bestie Alert! 💖</h2>

    <p>
      Shivani, never forget how special you are.
    </p>

    <p>
      Life will change, people will come and go,
      but the memories we create will always have
      their own little place. 🫂
    </p>

    <p>
      Keep smiling. Keep shining. ✨
    </p>

    <button onclick="nextPage()">Final Surprise 🎁</button>
  </div>
</section>

<!-- PAGE 7 -->
<section class="screen" id="page7">
  <div class="card">
    <div class="emoji">🎉</div>

    <h1>Happy Birthday</h1>

    <h2 class="name">Shivani! 👑💖</h2>

    <p>
      May this new year of your life bring
      happiness, success, love and lots of
      unforgettable moments. ✨
    </p>

    <p>
      Stay blessed and keep that beautiful smile forever. 🫂💗
    </p>

    <h2>🎂🎈🎁💖✨</h2>

    <p class="small">
      Made with lots of love just for you 💕
    </p>
  </div>
</section>

<script>

let currentPage = 1;

function nextPage(){

  document.getElementById("page"+currentPage)
    .classList.remove("active");

  currentPage++;

  if(currentPage > 7){
    currentPage = 7;
  }

  document.getElementById("page"+currentPage)
    .classList.add("active");

  if(currentPage === 7){
    startConfetti();
  }
}

function checkAnswer(){

  let answer =
    document.getElementById("answer").value
    .trim()
    .toLowerCase();

  let result =
    document.getElementById("result");

  if(answer === "october"){

    result.innerHTML =
      "🎉 Correct! You unlocked the next surprise! 💖";

    setTimeout(function(){
      nextPage();
    },1200);

  }else{

    result.innerHTML =
      "😜 Nope! Try again... Hint: It's in the last part of the year 🎂";

  }
}

function startConfetti(){

  for(let i=0;i<100;i++){

    let piece = document.createElement("div");

    piece.className = "confetti";

    piece.style.left =
      Math.random()*100 + "vw";

    piece.style.animationDelay =
      Math.random()*2 + "s";

    piece.style.background =
      "hsl(" + Math.random()*360 + ",90%,60%)";

    document.body.appendChild(piece);

    setTimeout(()=>{
      piece.remove();
    },6000);
  }
}

function createHeart(){

  let heart = document.createElement("div");

  heart.className = "heart";

  heart.innerHTML =
    ["💖","💕","💗","💓","❤️","✨"][Math.floor(Math.random()*6)];

  heart.style.left =
    Math.random()*100 + "vw";

  heart.style.animationDuration =
    (4 + Math.random()*4) + "s";

  document.body.appendChild(heart);

  
setTimeout(()=>{
    heart.remove();
  },8000);
}

setInterval(createHeart,700);

</script>

</body>
</html>
        
